# LLM provider: "ollama" (local, free, no key) or "openrouter" (cloud free tier).
LLM_PROVIDER=ollama
# Local Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_FALLBACK_MODELS=llama3.2:3b
# OpenRouter (used when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.2:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=AI Interview Prep Kit
# Optional per-request timeout override in ms (defaults: ollama 180000, openrouter 45000)
# LLM_TIMEOUT_MS=
MONGODB_URI=mongodb://127.0.0.1:27017/interview-kit
SESSION_SECRET=replace-with-a-long-random-string
ALLOW_PRIVATE_URLS=false
